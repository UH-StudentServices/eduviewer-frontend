# Needed until eslint-config-airbnb has support for Eslint v10.
legacy-peer-deps=true
# Supply-chain hardening: wait 3 days after a version is published before
# it is eligible for install, so compromised releases can be yanked first.
# Requires npm >= 11.10 (see "engines" in package.json). Older npm ignores this.
min-release-age=3
